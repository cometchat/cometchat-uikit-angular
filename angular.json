{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "cometchat-uikit": {
      "projectType": "library",
      "root": "projects/cometchat-uikit",
      "sourceRoot": "projects/cometchat-uikit/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/cometchat-uikit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/cometchat-uikit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/cometchat-uikit/tsconfig.spec.json"
          }
        }
      }
    },
    "sample-app": {
      "projectType": "application",
      "root": "projects/sample-app",
      "sourceRoot": "projects/sample-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/sample-app/src/main.ts",
            "tsConfig": "projects/sample-app/tsconfig.app.json",
            "allowedCommonJsDependencies": [
              "@cometchat/calls-sdk-javascript"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/sample-app/public"
              },
              {
                "glob": "**/*",
                "input": "projects/sample-app/src/assets",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "projects/cometchat-uikit/src/lib/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "projects/sample-app/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  // 5.5MB, was 5MB: Chat SDK 4.3 adds 0.54MB to the initial bundle (offline support
                  // ships in the SDK's one entry point); the kit's own offline code adds 0.12MB.
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "5.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "32kB",
                  "maximumError": "70kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": true
              },
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            // The online E2E suite (playwright.config.ts): the sample app turns offline on
            // by default; this build keeps the kit's own default (offline OFF).
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "CC_SAMPLE_OFFLINE_DEFAULT": "false"
              }
            },
            "offline-e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/sample-app/src/environments/environment.ts",
                  "with": "projects/sample-app/src/environments/environment.offline-e2e.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sample-app:build:production"
            },
            "development": {
              "buildTarget": "sample-app:build:development"
            },
            "e2e": {
              "buildTarget": "sample-app:build:e2e"
            },
            "offline-e2e": {
              "buildTarget": "sample-app:build:offline-e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "sample-app:build",
            "compodoc": false,
            "port": 6006,
            "tsConfig": ".storybook/tsconfig.json"
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "sample-app:build",
            "compodoc": false,
            "outputDir": "storybook-static",
            "tsConfig": ".storybook/tsconfig.json"
          }
        }
      }
    }
  }
}
