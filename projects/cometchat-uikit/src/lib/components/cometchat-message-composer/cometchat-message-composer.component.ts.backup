    }
  }

  /**
   * Handle selection update from TipTap editor
   * Updates the richTextFormatState signal to reflect active formats at cursor position
   * This ensures toolbar buttons display correct active/inactive state
   * @param formatState - The current format state from the editor
   * @private
   * @see Requirements 1.3, 1.4, 1.8, 1.9
   */
  private handleSelectionUpdate(formatState: RichTextFormatState): void {
    this.richTextFormatState.set(formatState);
  }

  /**
   * Update the format state signal from the current editor state
   * Called after formatting operations to ensure toolbar buttons reflect current state
   * @private
   * @see Requirements 1.3, 1.4, 1.8, 1.9
   */
  private updateFormatStateFromEditor(): void {
    if (this.tiptapEditor && this.enableRichText) {
      const formatState = this.tiptapEditorService.getFormatState(this.tiptapEditor);
      this.richTextFormatState.set(formatState);
    }
  }

  // ==================== Platform Detection ====================

  /**
   * Detect if platform is Web/Desktop for bubble menu feature
   * Checks for touch support to determine platform type.
   * Mobile devices typically have touch support, while desktop devices do not.
   * @returns true if platform is Web/Desktop (no touch support), false if mobile (has touch)
   * @private
   * @see Requirements 1.1
   */
  private isWebDesktopPlatform(): boolean {
    // Check if running in browser environment
    if (typeof window === 'undefined') return false;

    // Check for touch support (mobile devices typically have touch)
    const hasTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

    // Consider it desktop if no touch support
    return !hasTouch;
  }
}
