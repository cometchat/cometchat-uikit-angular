# CometChat E2E Test Configuration
#
# These values are OPTIONAL — by default, credentials are read from:
#   projects/sample-app/src/environments/environment.ts
#
# Set these environment variables to override (useful for CI or
# running against a different CometChat app):

# E2E_APP_ID=your_app_id
# E2E_REGION=us
# E2E_AUTH_KEY=your_auth_key
# E2E_API_KEY=your_rest_api_key
# E2E_USER_UID=cometchat-uid-1
# Agent-in-group tests: UID and display name of the AI agent user
# E2E_AGENT_UID=e2e-agent-uid
# E2E_AGENT_NAME=e2e_agent_name