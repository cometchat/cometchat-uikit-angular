# CometChat E2E Test Configuration
#
# Copy this file to .env at the repo root (git ignores it) and fill in the values. E2E keys
# live only here or in CI secrets, never in projects/sample-app/src/environments/environment.ts,
# which is committed with placeholders (the pre-commit hook blocks real keys there).

# E2E_APP_ID=your_app_id
# E2E_REGION=us
# E2E_AUTH_KEY=your_auth_key
# E2E_API_KEY=your_rest_api_key
# E2E_USER_UID=cometchat-uid-1
# Isolated run: with E2E_RUN_ID set, the run creates and logs in as users of its own
# (e2e-<run>-alice/-bob/-carol) and ignores E2E_USER_UID, so concurrent runs (CI shards,
# two PRs) on the same app never see each other's messages, calls or unread counts.
# E2E_RUN_ID=my-run
# Agent-in-group tests: UID and display name of the AI agent user
# E2E_AGENT_UID=e2e-agent-uid
# E2E_AGENT_NAME=e2e_agent_name